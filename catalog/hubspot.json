{
  "id": "hubspot",
  "name": "HubSpot",
  "description": "Read and update contacts, companies, deals, tickets, notes and tasks in a HubSpot CRM, through HubSpot's official MCP server (beta).",
  "homepage": "https://www.npmjs.com/package/@hubspot/mcp-server",
  "server": {
    "package": "@hubspot/mcp-server",
    "version": "0.4.0"
  },
  "credentials": [
    {
      "env": "PRIVATE_APP_ACCESS_TOKEN",
      "title": "HubSpot private app access token",
      "description": "In HubSpot: Settings, Integrations, Private Apps, Create private app. Give it only the scopes listed in the setup steps, then copy its access token."
    }
  ],
  "actions": {
    "hubspot-read": "Read CRM records, their associations and properties, engagements, schemas and workflows",
    "hubspot-write": "Create and update CRM records, associations, notes and tasks",
    "hubspot-schema": "Create and change CRM properties (the fields every record has)"
  },
  "serviceSetup": {
    "title": "HubSpot private app scopes",
    "where": "HubSpot Settings, Integrations, Private Apps, your app, Scopes",
    "scope": "Tick these only for the objects the agent works with (for example contacts and companies, not every object). HubSpot suggests starting read-only.",
    "byAction": {
      "hubspot-read": [
        "crm.objects.<object>.read for each object the agent reads",
        "crm.schemas.<object>.read for those objects",
        "automation, only if it reads workflows"
      ],
      "hubspot-write": [
        "crm.objects.<object>.write for each object the agent may change"
      ],
      "hubspot-schema": [
        "crm.schemas.<object>.write for each object whose properties it may change"
      ]
    }
  },
  "probeEnv": {
    "PRIVATE_APP_ACCESS_TOKEN": "dummy-token-for-listing-tools"
  },
  "reviewed": {
    "by": "MetaMynd",
    "on": "2026-10-15"
  },
