{
  "id": "brave-search",
  "name": "Brave Search",
  "description": "Search the web, news, images, videos and places with Brave Search, through Brave's official MCP server. Read-only; what the agent searches for is sent to Brave.",
  "homepage": "https://github.com/brave/brave-search-mcp-server",
  "server": {
    "package": "@brave/brave-search-mcp-server",
    "version": "2.1.4"
  },
  "credentials": [
    {
      "env": "BRAVE_API_KEY",
      "title": "Brave Search API key",
      "description": "Create a key at api-dashboard.search.brave.com (the free plan works for web search; local search needs a Pro plan)."
    }
  ],
  "actions": {
    "web-search": "Search the web, news, images, videos and places, and summarize the results"
  },
  "probeEnv": {
    "BRAVE_API_KEY": "BSA_dummy0000000000000000000000"
  },
  "reviewed": {
    "by": "MetaMynd",
    "on": "2026-10-15"
  },
  "tools": {
    "brave_web_search": {
      "summary": "Search the web",
      "action": "web-search",
      "effect": "read",
      "allowedArgs": [
        "query",
        "country",
        "search_lang",
        "ui_lang",
        "count",
        "offset",
        "safesearch",
        "freshness",
        "text_decorations",
