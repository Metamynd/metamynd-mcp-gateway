{
  "id": "notion",
  "name": "Notion",
  "description": "Read and edit pages, databases and comments in a Notion workspace, through Notion's official MCP server.",
  "homepage": "https://github.com/makenotion/notion-mcp-server",
  "server": {
    "package": "@notionhq/notion-mcp-server",
    "version": "2.5.2"
  },
  "credentials": [
    {
      "env": "NOTION_TOKEN",
      "title": "Notion integration token",
      "description": "Create an internal integration at notion.so/my-integrations, copy its secret, and share the pages the agent may use with that integration."
    }
  ],
  "actions": {
    "notion-read": "Read pages, databases, comments and members",
    "notion-write": "Create and change pages, databases and comments",
    "notion-delete": "Delete blocks (moved to the trash)"
  },
  "serviceSetup": {
    "title": "Notion integration capabilities",
    "where": "notion.so/my-integrations, your integration, Capabilities",
    "scope": "Share only the pages and databases the agent needs: on each page, open the ••• menu, Connections, and add the integration. Pages you don't share stay out of reach, whatever the agent is granted.",
    "byAction": {
      "notion-read": ["Read content", "Read comments", "Read user information without email addresses"],
      "notion-write": ["Insert content", "Update content", "Insert comments"],
      "notion-delete": ["Update content"]
    }
  },
  "probeEnv": {
    "NOTION_TOKEN": "ntn_dummy0000000000000000000000000000000000000"
  },
  "reviewed": {
    "by": "MetaMynd",
    "on": "2026-10-14"
  },
